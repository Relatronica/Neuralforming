# ─── Neuralforming Server — Variabili d'Ambiente ───
# Copia questo file in .env e modifica i valori secondo il tuo ambiente.

# Ambiente di esecuzione (development | production)
NODE_ENV=development

# Porta su cui il server ascolta
PORT=3001

# URL del client frontend (per la configurazione CORS).
# In sviluppo locale, il client Vite gira di default sulla porta 5173.
# In produzione, usa l'URL del tuo sito Netlify (es: https://neuralforming.netlify.app)
CLIENT_URL=http://localhost:5173
