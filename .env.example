# ─── Neuralforming — Variabili d'Ambiente (Frontend) ───
# Copia questo file in .env e modifica i valori secondo il tuo ambiente.

# URL del server WebSocket per il multiplayer.
# In sviluppo locale, il server gira di default sulla porta 3001.
# In produzione, usa l'URL del tuo servizio Render (es: https://neuralforming-server.onrender.com)
VITE_SERVER_URL=http://localhost:3001

# Form Contatti (Netlify Function in produzione, middleware Vite in locale).
# Crea una API key su https://resend.com — senza chiave l'invio risponde 503.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@relatronica.com
CONTACT_FROM_EMAIL=Neuralforming <onboarding@resend.dev>
